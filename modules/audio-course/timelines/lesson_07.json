    {
      "id": "L07_A038",
      "speaker": "instructor",
      "text": "How much is this?",
      "start": 109.272,
      "end": 110.272,
      "pause_end": 110.872
    },
    {
      "id": "L07_A039",
      "speaker": "arabic_female",
      "text": "بكم هذا؟",
      "start": 110.872,
      "end": 111.755,
      "pause_end": 113.105
    },
    {
      "id": "L07_A040",
      "speaker": "instructor",
      "text": "For ten dirhams.",
      "start": 113.105,
      "end": 115.065,
      "pause_end": 115.665
    },
    {
      "id": "L07_A041",
      "speaker": "arabic",
      "text": "بعشرة دراهم",
      "start": 115.665,
      "end": 117.104,
      "pause_end": 118.454
    },
    {
      "id": "L07_A042",
      "speaker": "instructor",
      "text": "This is expensive.",
      "start": 118.454,
      "end": 119.774,
      "pause_end": 120.374
    },
    {
      "id": "L07_A043",
      "speaker": "arabic_female",
      "text": "هذا غالي",
      "start": 120.374,
      "end": 121.396,
      "pause_end": 122.746
    },
    {
      "id": "L07_A044",
      "speaker": "instructor",
      "text": "Do you have something cheaper?",
      "start": 122.746,
      "end": 124.426,
      "pause_end": 125.026
    },
    {
      "id": "L07_A045",
      "speaker": "arabic",
      "text": "عندك أرخص؟",
      "start": 125.026,
      "end": 126.28,
      "pause_end": 127.63
    },
    {
      "id": "L07_A046",
      "speaker": "instructor",
      "text": "I want two.",
      "start": 127.63,
      "end": 129.31,
      "pause_end": 129.91
    },
    {
      "id": "L07_A047",
      "speaker": "arabic_female",
      "text": "أبغي اثنين",
      "start": 129.91,
      "end": 130.932,
      "pause_end": 132.282
    },
    {
      "id": "L07_A048",
      "speaker": "instructor",
      "text": "What is the total?",
      "start": 132.282,
      "end": 133.362,
      "pause_end": 133.962
    },
    {
      "id": "L07_A049",
      "speaker": "arabic",
      "text": "كم المجموع؟",
      "start": 133.962,
      "end": 135.076,
      "pause_end": 136.426
    },
    {
      "id": "L07_A050",
      "speaker": "instructor",
      "text": "Twenty dirhams.",
      "start": 136.426,
      "end": 138.186,
      "pause_end": 138.786
    },
    {
      "id": "L07_A051",
      "speaker": "arabic_female",
      "text": "عشرين درهم",
      "start": 138.786,
      "end": 139.994,
      "pause_end": 141.344
    },
    {
      "id": "L07_A052",
      "speaker": "instructor",
