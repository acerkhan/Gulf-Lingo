{
  "events": [
    {
      "id": "L07_A001",
      "speaker": "instructor",
      "text": "Lesson 7. Numbers and Shopping. Listen carefully, and speak when you hear a question.",
      "start": 0.0,
      "end": 5.52,
      "pause_end": 6.57
    },
    {
      "id": "L07_A002",
      "speaker": "instructor",
      "text": "First, remember some expressions from earlier lessons.",
      "start": 6.57,
      "end": 10.53,
      "pause_end": 11.38
    },
    {
      "id": "L07_A003",
      "speaker": "instructor",
      "text": "Say pleased to meet you.",
      "start": 11.38,
      "end": 13.42,
      "pause_end": 17.87
    },
    {
      "id": "L07_A004",
      "speaker": "arabic_female",
      "text": "تشرفنا",
      "start": 17.87,
      "end": 18.799,
      "pause_end": 19.749
    },
    {
      "id": "L07_A005",
      "speaker": "instructor",
      "text": "Greet someone.",
      "start": 19.749,
      "end": 20.629,
      "pause_end": 25.079
    },
    {
      "id": "L07_A006",
      "speaker": "arabic",
      "text": "السلام عليكم",
      "start": 25.079,
      "end": 26.24,
      "pause_end": 27.19
    },
    {
      "id": "L07_A007",
      "speaker": "instructor",
      "text": "Ask a man how he is.",
      "start": 27.19,
      "end": 29.11,
      "pause_end": 33.56
    },
    {
      "id": "L07_A008",
      "speaker": "arabic_female",
      "text": "شحالك؟",
      "start": 33.56,
      "end": 34.535,
      "pause_end": 35.485
    },
    {
      "id": "L07_A009",
      "speaker": "instructor",
      "text": "Ask a man his name.",
      "start": 35.485,
      "end": 36.885,
      "pause_end": 41.335
    },
    {
      "id": "L07_A010",
      "speaker": "arabic_female",
      "text": "شو اسمك؟",
      "start": 41.335,
      "end": 42.171,
      "pause_end": 43.121
    },
    {
      "id": "L07_A011",
      "speaker": "instructor",
      "text": "Ask a man where he is from.",
      "start": 43.121,
      "end": 44.921,
      "pause_end": 49.371
    },
    {
      "id": "L07_A012",
      "speaker": "arabic_female",
      "text": "من وين إنت؟",
      "start": 49.371,
      "end": 50.393,
      "pause_end": 51.343
    },
    {
      "id": "L07_A013",
      "speaker": "instructor",
      "text": "Ask a man where he lives.",
      "start": 51.343,
      "end": 53.143,
      "pause_end": 57.593
    },
    {
      "id": "L07_A014",
      "speaker": "arabic_female",
      "text": "وين ساكن؟",
      "start": 57.593,
      "end": 58.661,
      "pause_end": 59.611
    },
    {
      "id": "L07_A015",
      "speaker": "instructor",
      "text": "Say that you want water.",
      "start": 59.611,
      "end": 61.131,
      "pause_end": 65.581
    },
    {
      "id": "L07_A016",
      "speaker": "arabic",
      "text": "أبغي ماي",
      "start": 65.581,
      "end": 66.556,
      "pause_end": 67.506
    },
    {
      "id": "L07_A017",
      "speaker": "instructor",
      "text": "Ask for the bill.",
      "start": 67.506,
      "end": 68.706,
      "pause_end": 73.156
    },
    {
      "id": "L07_A018",
      "speaker": "arabic",
      "text": "كم الحساب؟",
      "start": 73.156,
      "end": 74.317,
      "pause_end": 75.267
    },
    {
      "id": "L07_A019",
