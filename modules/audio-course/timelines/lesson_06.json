{
  "events": [
    {
      "id": "L06_A001",
      "speaker": "instructor",
      "text": "Lesson 6. Questions and Answers. Listen carefully, and speak when you hear a question.",
      "start": 0.0,
      "end": 6.68,
      "pause_end": 7.73
    },
    {
      "id": "L06_A002",
      "speaker": "instructor",
      "text": "First, remember some expressions from earlier lessons.",
      "start": 7.73,
      "end": 11.69,
      "pause_end": 12.54
    },
    {
      "id": "L06_A003",
      "speaker": "instructor",
      "text": "Ask for the bill.",
      "start": 12.54,
      "end": 13.74,
      "pause_end": 18.19
    },
    {
      "id": "L06_A004",
      "speaker": "arabic",
      "text": "كم الحساب؟",
      "start": 18.19,
      "end": 19.351,
      "pause_end": 20.301
    },
    {
      "id": "L06_A005",
      "speaker": "instructor",
      "text": "Say pleased to meet you.",
      "start": 20.301,
      "end": 22.341,
      "pause_end": 26.791
    },
    {
      "id": "L06_A006",
      "speaker": "arabic_female",
      "text": "تشرفنا",
      "start": 26.791,
      "end": 27.72,
      "pause_end": 28.67
    },
    {
      "id": "L06_A007",
      "speaker": "instructor",
      "text": "Greet someone.",
      "start": 28.67,
      "end": 29.55,
      "pause_end": 34.0
    },
    {
      "id": "L06_A008",
      "speaker": "arabic",
      "text": "السلام عليكم",
      "start": 34.0,
      "end": 35.161,
      "pause_end": 36.111
    },
    {
      "id": "L06_A009",
      "speaker": "instructor",
      "text": "Ask a man how he is.",
      "start": 36.111,
      "end": 38.031,
      "pause_end": 42.481
    },
    {
      "id": "L06_A010",
      "speaker": "arabic_female",
      "text": "شحالك؟",
      "start": 42.481,
      "end": 43.456,
      "pause_end": 44.406
    },
    {
      "id": "L06_A011",
      "speaker": "instructor",
      "text": "Ask a man his name.",
      "start": 44.406,
      "end": 45.806,
      "pause_end": 50.256
    },
    {
      "id": "L06_A012",
      "speaker": "arabic_female",
      "text": "شو اسمك؟",
      "start": 50.256,
      "end": 51.092,
      "pause_end": 52.042
    },
    {
      "id": "L06_A013",
      "speaker": "instructor",
      "text": "Ask a man where he is from.",
      "start": 52.042,
      "end": 53.842,
      "pause_end": 58.292
    },
    {
      "id": "L06_A014",
      "speaker": "arabic_female",
      "text": "من وين إنت؟",
      "start": 58.292,
      "end": 59.314,
      "pause_end": 60.264
    },
    {
      "id": "L06_A015",
      "speaker": "instructor",
      "text": "Ask a man where he lives.",
      "start": 60.264,
      "end": 62.064,
      "pause_end": 66.514
    },
    {
      "id": "L06_A016",
      "speaker": "arabic_female",
      "text": "وين ساكن؟",
      "start": 66.514,
      "end": 67.582,
      "pause_end": 68.532
    },
    {
      "id": "L06_A017",
      "speaker": "instructor",
      "text": "Say that you want water.",
      "start": 68.532,
      "end": 70.052,
      "pause_end": 74.502
    },
    {
      "id": "L06_A018",
      "speaker": "arabic",
      "text": "أبغي ماي",
      "start": 74.502,
      "end": 75.477,
      "pause_end": 76.427
    },
    {
      "id": "L06_A019",
      "speaker": "instructor",
      "text": "Now listen to the new expressions.",
      "start": 76.427,
      "end": 78.587,
      "pause_end": 79.437
    },
    {
      "id": "L06_A020",
      "speaker": "instructor",
      "text": "What is this?",
      "start": 79.437,
      "end": 80.357,
      "pause_end": 80.957
    },
    {
      "id": "L06_A021",
      "speaker": "arabic_female",
      "text": "شو هذا؟",
      "start": 80.957,
      "end": 81.84,
      "pause_end": 83.19
    },
    {
      "id": "L06_A022",
      "speaker": "instructor",
      "text": "This is a book.",
