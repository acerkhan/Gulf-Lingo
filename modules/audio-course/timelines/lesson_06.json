      "end": 120.39,
      "pause_end": 120.99
    },
    {
      "id": "L06_A039",
      "speaker": "arabic",
      "text": "هيه، عندي سؤال",
      "start": 120.99,
      "end": 122.616,
      "pause_end": 123.966
    },
    {
      "id": "L06_A040",
      "speaker": "instructor",
      "text": "Did you understand?",
      "start": 123.966,
      "end": 125.046,
      "pause_end": 125.646
    },
    {
      "id": "L06_A041",
      "speaker": "arabic_female",
      "text": "فهمت؟",
      "start": 125.646,
      "end": 126.435,
      "pause_end": 127.785
    },
    {
      "id": "L06_A042",
      "speaker": "instructor",
      "text": "Yes, I understood.",
      "start": 127.785,
      "end": 129.705,
      "pause_end": 130.305
    },
    {
      "id": "L06_A043",
      "speaker": "arabic",
      "text": "هيه، فهمت",
