{
  "events": [
    {
      "id": "L09_A001",
      "speaker": "instructor",
      "text": "Lesson 9. Getting Around. Listen carefully, and speak when you hear a question.",
      "start": 0.0,
      "end": 4.96,
      "pause_end": 6.01
    },
    {
      "id": "L09_A002",
      "speaker": "instructor",
      "text": "First, remember some expressions from earlier lessons.",
      "start": 6.01,
      "end": 9.97,
      "pause_end": 10.82
    },
    {
      "id": "L09_A003",
      "speaker": "instructor",
      "text": "Ask a man how he is.",
      "start": 10.82,
      "end": 12.74,
      "pause_end": 17.19
    },
    {
      "id": "L09_A004",
      "speaker": "arabic_female",
      "text": "شحالك؟",
      "start": 17.19,
      "end": 18.165,
      "pause_end": 19.115
    },
    {
      "id": "L09_A005",
      "speaker": "instructor",
      "text": "Ask a man his name.",
      "start": 19.115,
      "end": 20.515,
      "pause_end": 24.965
    },
    {
      "id": "L09_A006",
      "speaker": "arabic_female",
      "text": "شو اسمك؟",
      "start": 24.965,
      "end": 25.801,
      "pause_end": 26.751
    },
    {
      "id": "L09_A007",
      "speaker": "instructor",
      "text": "Ask a man where he is from.",
      "start": 26.751,
      "end": 28.551,
      "pause_end": 33.001
    },
    {
      "id": "L09_A008",
      "speaker": "arabic_female",
      "text": "من وين إنت؟",
      "start": 33.001,
      "end": 34.023,
      "pause_end": 34.973
    },
    {
      "id": "L09_A009",
      "speaker": "instructor",
      "text": "Ask a man where he lives.",
      "start": 34.973,
      "end": 36.773,
      "pause_end": 41.223
    },
    {
      "id": "L09_A010",
      "speaker": "arabic_female",
      "text": "وين ساكن؟",
      "start": 41.223,
      "end": 42.291,
      "pause_end": 43.241
    },
    {
      "id": "L09_A011",
      "speaker": "instructor",
      "text": "Say that you want water.",
      "start": 43.241,
      "end": 44.761,
      "pause_end": 49.211
    },
    {
      "id": "L09_A012",
      "speaker": "arabic",
      "text": "أبغي ماي",
      "start": 49.211,
      "end": 50.186,
      "pause_end": 51.136
    },
    {
      "id": "L09_A013",
      "speaker": "instructor",
      "text": "Ask for the bill.",
      "start": 51.136,
      "end": 52.336,
      "pause_end": 56.786
    },
    {
      "id": "L09_A014",
      "speaker": "arabic",
      "text": "كم الحساب؟",
      "start": 56.786,
      "end": 57.947,
      "pause_end": 58.897
    },
    {
      "id": "L09_A015",
      "speaker": "instructor",
      "text": "Say pleased to meet you.",
      "start": 58.897,
      "end": 60.937,
      "pause_end": 65.387
    },
    {
      "id": "L09_A016",
      "speaker": "arabic_female",
      "text": "تشرفنا",
      "start": 65.387,
      "end": 66.316,
      "pause_end": 67.266
    },
    {
      "id": "L09_A017",
      "speaker": "instructor",
      "text": "Greet someone.",
      "start": 67.266,
      "end": 68.146,
      "pause_end": 72.596
    },
    {
      "id": "L09_A018",
      "speaker": "arabic",
      "text": "السلام عليكم",
      "start": 72.596,
      "end": 73.757,
      "pause_end": 74.707
    },
    {
      "id": "L09_A019",
      "speaker": "instructor",
      "text": "Now listen to the new expressions.",
      "start": 74.707,
      "end": 76.867,
      "pause_end": 77.717
    },
    {
      "id": "L09_A020",
      "speaker": "instructor",
      "text": "Where is the market?",
      "start": 77.717,
      "end": 78.957,
      "pause_end": 79.557
    },
    {
      "id": "L09_A021",
      "speaker": "arabic_female",
      "text": "وين السوق؟",
      "start": 79.557,
      "end": 80.672,
      "pause_end": 82.022
    },
    {
      "id": "L09_A022",
      "speaker": "instructor",
      "text": "The market is nearby.",
