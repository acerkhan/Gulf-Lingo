      "speaker": "instructor",
      "text": "Where is the station?",
      "start": 86.872,
      "end": 88.232,
      "pause_end": 88.832
    },
    {
      "id": "L09_A025",
      "speaker": "arabic_female",
      "text": "وين المحطة؟",
