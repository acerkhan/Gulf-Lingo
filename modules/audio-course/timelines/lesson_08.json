      "end": 37.032,
      "pause_end": 41.482
    },
    {
      "id": "L08_A010",
      "speaker": "arabic_female",
      "text": "من وين إنت؟",
      "start": 41.482,
      "end": 42.504,
      "pause_end": 43.454
    },
    {
      "id": "L08_A011",
      "speaker": "instructor",
      "text": "Ask a man where he lives.",
