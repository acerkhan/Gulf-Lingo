    {
      "id": "L08_A001",
      "speaker": "instructor",
      "text": "Lesson 8. Time and Daily Routines. Listen carefully, and speak when you hear a question.",
      "start": 0.0,
      "end": 6.0,
      "pause_end": 7.05
    },
    {
      "id": "L08_A002",
      "speaker": "instructor",
      "text": "First, remember some expressions from earlier lessons.",
      "start": 7.05,
      "end": 11.01,
      "pause_end": 11.86
    },
    {
      "id": "L08_A003",
      "speaker": "instructor",
      "text": "Greet someone.",
      "start": 11.86,
      "end": 12.74,
      "pause_end": 17.19
    },
    {
      "id": "L08_A004",
      "speaker": "arabic",
      "text": "السلام عليكم",
      "start": 17.19,
      "end": 18.351,
      "pause_end": 19.301
    },
    {
      "id": "L08_A005",
      "speaker": "instructor",
      "text": "Ask a man how he is.",
      "start": 19.301,
      "end": 21.221,
      "pause_end": 25.671
    },
    {
      "id": "L08_A006",
      "speaker": "arabic_female",
      "text": "شحالك؟",
      "start": 25.671,
      "end": 26.646,
      "pause_end": 27.596
    },
    {
      "id": "L08_A007",
      "speaker": "instructor",
      "text": "Ask a man his name.",
      "start": 27.596,
      "end": 28.996,
      "pause_end": 33.446
    },
    {
      "id": "L08_A008",
      "speaker": "arabic_female",
      "text": "شو اسمك؟",
